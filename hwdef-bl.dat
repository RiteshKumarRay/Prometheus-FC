# Bootloader hwdef for DevEBox STM32H743VIT6
# Minimal - only what's needed to receive firmware over USB DFU

MCU STM32H7xx STM32H743xx

OSCILLATOR_HZ 25000000
APJ_BOARD_ID 7121

FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 0
FLASH_BOOTLOADER_LOAD_KB 128

# USB for firmware upload
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# SWD debug
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# LED - PA1 on DevEBox, active low
PA1 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 0

SERIAL_ORDER OTG1
