# hw definition file for processing by chibios_hwdef.py
# DevEBox STM32H743VIT6 V3.0 - Prometheus FC
# Based on confirmed V2.0/V3.0 schematic (pins identical, USB-C only change)

# MCU class and specific type
MCU STM32H7xx STM32H743xx

# board ID - use 1043 (safe gap above last known ID)
APJ_BOARD_ID 7121

# DevEBox uses 25MHz HSE crystal (Y2 on board)
# CRITICAL: Matek/AET use 8MHz - wrong value = PLL failure = no boot
OSCILLATOR_HZ 25000000

FLASH_SIZE_KB 2048

# bootloader occupies first 128KB sector
FLASH_RESERVE_START_KB 128

# ChibiOS system timer - TIM12 is safe on H743, not used by motors
STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

USB_STRING_MANUFACTURER "Prometheus-FC"
USB_STRING_PRODUCT "DevEBoxH743"

# ---- USB (fixed by OTG_FS peripheral, confirmed DevEBox schematic) ----
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# ---- SWD debug (confirmed DevEBox schematic) ----
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# ---- LED and Buzzer ----
# DevEBox confirmed: D2 LED on PA1, active low
PA1 LED_BOOTLOADER OUTPUT LOW
define HAL_LED_ON 1

# External Status LEDs on PE2 (LED0), PE3 (LED1), PB0 (LED2) & Buzzer on PE4
define HAL_GPIO_LED_ON 1
PE2 LED0 OUTPUT LOW GPIO(90)
PE3 LED1 OUTPUT LOW GPIO(91)
PB0 LED2 OUTPUT LOW GPIO(92)

# Sync PE2 LED with the Buzzer
define HAL_BUZZER_LED_PIN 90

PE4 BUZZER OUTPUT GPIO(80) LOW
define HAL_BUZZER_PIN 80


# ---- microSD (confirmed DevEBox schematic - SDMMC1) ----
PC8  SDMMC1_D0  SDMMC1
PC9  SDMMC1_D1  SDMMC1
PC10 SDMMC1_D2  SDMMC1
PC11 SDMMC1_D3  SDMMC1
PC12 SDMMC1_CK  SDMMC1
PD2  SDMMC1_CMD SDMMC1

# ---- SPI1 - IMU1 (BMI160) + Baro1 (BMP280) ----
# PA5/PA6 confirmed DevEBox SPI1; PD7 MOSI from AET (verify on your board)
PA5  SPI1_SCK  SPI1
PA6  SPI1_MISO SPI1
PD7  SPI1_MOSI SPI1
PB5  IMU1_CS   CS    # BMI160 #1 Chip Select
PB12 BARO1_CS  CS    # BMP280 #1 Chip Select

# ---- SPI4 - IMU2 (BMI160) + Baro2 (BMP280) ----
# PE12/PE13/PE14 confirmed available on LQFP100 H743
PE12 SPI4_SCK  SPI4
PE13 SPI4_MISO SPI4 PULLUP
PE14 SPI4_MOSI SPI4
PD4  IMU2_CS     CS  # BMI160 #2 Chip Select on SPI4 (PD4)
PB13 BARO2_CS    CS  # BMP280 #2 Chip Select

# ---- I2C1 - Baro + Compass ----
PB6 I2C1_SCL I2C1 PULLUP
PB7 I2C1_SDA I2C1 PULLUP

# ---- I2C2 - spare / external ----
PB10 I2C2_SCL I2C2 PULLUP
PB11 I2C2_SDA I2C2 PULLUP

I2C_ORDER I2C1 I2C2

# Force both I2C buses to 100kHz standard mode (compatible with internal pull-ups)
define HAL_I2C_INTERNAL_MASK 0

# ---- UARTs ----
# SERIAL_ORDER: USB, USART1(GPS), USART2(Radxa MAVLink), USART3(Telem),
#               UART4(RC), USART6(spare), UART7(debug), UART8(spare)
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4 USART6 UART7 UART8

# USART1 - GPS
PA9  USART1_TX USART1
PA10 USART1_RX USART1

# USART2 - Radxa Cubie A7S MAVLink link
PD5 USART2_TX USART2
PD6 USART2_RX USART2

# USART3 - Telemetry (LoRa/RC link)
PD8 USART3_TX USART3
PD9 USART3_RX USART3

# UART4 - RC input (SBUS/CRSF)
PB8 UART4_RX UART4
PB9 UART4_TX UART4

# USART6 - spare
PC6 USART6_TX USART6
PC7 USART6_RX USART6

# UART7 - debug console
PE7 UART7_RX UART7
PE8 UART7_TX UART7

# UART8 - spare
PE0 UART8_RX UART8
PE1 UART8_TX UART8

# ---- Motor outputs (DShot) - 4 motors for quadcopter ----
# Using TIM4 on PD12-PD15 - clean timer, no DMA conflict with SPI1/SPI4
# These are the 4 motor channels for Prometheus S500 frame
PD12 TIM4_CH1 TIM4 PWM(1) GPIO(50)
PD13 TIM4_CH2 TIM4 PWM(2) GPIO(51)
PD14 TIM4_CH3 TIM4 PWM(3) GPIO(52)
PD15 TIM4_CH4 TIM4 PWM(4) GPIO(53)

# ---- SPI device definitions ----
# IMU: BMI160 uses MODE3, 1MHz init / 10MHz run
SPIDEV bmi160_0  SPI1 DEVID1 IMU1_CS  MODE3 1*MHZ 10*MHZ
SPIDEV bmi160_1  SPI4 DEVID2 IMU2_CS  MODE3 1*MHZ 10*MHZ
# BARO: BMP280 uses MODE3, 1MHz init / 10MHz run
SPIDEV bmp280_0  SPI1 DEVID3 BARO1_CS MODE3 1*MHZ 10*MHZ
SPIDEV bmp280_1  SPI4 DEVID4 BARO2_CS MODE3 1*MHZ 10*MHZ

# Prevent SPI1 and SPI4 DMA from conflicting with each other
DMA_NOSHARE SPI1* SPI4*

# ---- IMU definitions (dual BMI160 on SPI1 + SPI4) ----
IMU BMI160 SPI:bmi160_0 ROTATION_ROLL_180
IMU BMI160 SPI:bmi160_1 ROTATION_ROLL_180
IMU Invensense I2C:1:0x69 ROTATION_NONE
IMU Invensensev3 I2C:1:0x68 ROTATION_NONE
IMU Invensensev3 I2C:1:0x69 ROTATION_NONE

define HAL_DEFAULT_INS_FAST_SAMPLE 1

# ---- Barometer (dual BMP280 on SPI1 + SPI4) ----
BARO BMP280 SPI:bmp280_0
BARO BMP280 SPI:bmp280_1

# ---- Compass ----
# No internal compass on DevEBox - probe external only
define ALLOW_ARM_NO_COMPASS
define AP_COMPASS_PROBING_ENABLED 1
define HAL_I2C_INTERNAL_MASK 0
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

# ---- Storage ----
define HAL_STORAGE_SIZE 32768
define HAL_OS_FATFS_IO 1

# use flash pages 14-15 for parameter storage
# H743 has 16 pages of 128KB each
STORAGE_FLASH_PAGE 14

# ---- DMA priority ----
DMA_PRIORITY S*

# ---- Serial protocol defaults ----
define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_GPS      # GPS1 on USART1
define DEFAULT_SERIAL1_BAUD 115
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_MAVLink2 # Radxa companion on USART2
define DEFAULT_SERIAL2_BAUD 115
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_MAVLink2 # Telemetry on USART3
define DEFAULT_SERIAL3_BAUD 57
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_RCIN     # RC Receiver on UART4
define DEFAULT_SERIAL5_PROTOCOL SerialProtocol_GPS      # GPS2 on USART6
define DEFAULT_SERIAL5_BAUD 115

# Battery Voltage and Current Sensing (ADC)
PA2 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PA3 BATT_CURRENT_SENS ADC1 SCALE(1)
define HAL_BATT_VOLT_PIN 14
define HAL_BATT_CURR_PIN 15
define HAL_BATT_VOLT_SCALE 11.0
define HAL_BATT_CURR_SCALE 11.0

# CAN Bus
PD0 CAN1_RX CAN1
PD1 CAN1_TX CAN1
define HAL_NUM_CAN_IFACES 1
